{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagnosis_report.schema.json",
  "title": "diagnosis_report.json output contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "run_id",
    "iteration",
    "producer",
    "mode",
    "created_at",
    "status",
    "input_refs",
    "errors",
    "runtime_metrics",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "artifact_type": {
      "const": "diagnosis_report"
    },
    "artifact_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "run_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "iteration": {
      "type": "integer",
      "minimum": 0
    },
    "producer": {
      "const": "reporter"
    },
    "mode": {
      "enum": [
        "diagnosis",
        "development"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ]
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/errorItem"
      }
    },
    "runtime_metrics": {
      "oneOf": [
        {
          "$ref": "#/$defs/runtimeMetrics"
        },
        {
          "type": "null"
        }
      ]
    },
    "data": {
      "oneOf": [
        {
          "$ref": "#/$defs/reportData"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/statusRules"
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_type",
        "iteration",
        "path",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "artifact_type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "iteration": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "kind",
        "path",
        "sha256",
        "redacted"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "enum": [
            "request",
            "response",
            "dom",
            "screenshot",
            "state",
            "execution_log"
          ]
        },
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "redacted": {
          "type": "boolean"
        }
      }
    },
    "errorItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "item_ref",
        "retryable"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "message": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "item_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "runtimeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_ms",
        "llm_calls",
        "input_tokens",
        "output_tokens",
        "peak_memory_mb"
      ],
      "properties": {
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "llm_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "peak_memory_mb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "modelInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "model_version",
        "prompt_version",
        "temperature",
        "seed"
      ],
      "properties": {
        "model_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "model_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "prompt_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "reportSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_count",
        "confirmed_count",
        "not_confirmed_count",
        "suspected_count",
        "indeterminate_count",
        "policy_blocked_count",
        "approval_pending_count"
      ],
      "properties": {
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed_count": {
          "type": "integer",
          "minimum": 0
        },
        "not_confirmed_count": {
          "type": "integer",
          "minimum": 0
        },
        "suspected_count": {
          "type": "integer",
          "minimum": 0
        },
        "indeterminate_count": {
          "type": "integer",
          "minimum": 0
        },
        "policy_blocked_count": {
          "type": "integer",
          "minimum": 0
        },
        "approval_pending_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "candidate_id",
        "scenario_id",
        "verification_id",
        "category",
        "vulnerability_type",
        "status",
        "title",
        "description",
        "evidence_refs"
      ],
      "properties": {
        "finding_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "candidate_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "scenario_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "verification_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "category": {
          "enum": [
            "authorization",
            "business_logic"
          ]
        },
        "vulnerability_type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "enum": [
            "confirmed",
            "suspected",
            "not_confirmed",
            "indeterminate",
            "policy_blocked",
            "approval_pending"
          ]
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        }
      }
    },
    "reportData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_url",
        "summary",
        "findings",
        "limitations"
      ],
      "properties": {
        "target_url": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "summary": {
          "$ref": "#/$defs/reportSummary"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "statusRules": {
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "errors": {
                "maxItems": 0
              },
              "data": {
                "$ref": "#/$defs/reportData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "partial"
              }
            }
          },
          "then": {
            "properties": {
              "errors": {
                "minItems": 1
              },
              "data": {
                "$ref": "#/$defs/reportData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "errors": {
                "minItems": 1
              },
              "data": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}

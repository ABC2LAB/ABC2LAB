{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abc2lab/semantic_analyzer/output/semantic_analysis.schema.json",
  "title": "semantic_analysis.json input contract",
  "description": "m2-semantic_analyzer.md v0.2 기준(Resource 입력 계약 0.2). 직접 소비자: knowledge_graph, reporter(개발 평가).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "artifact_id", "run_id", "iteration",
    "producer", "mode", "created_at", "status", "input_refs", "errors",
    "runtime_metrics", "data"
  ],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "artifact_type": { "const": "semantic_analysis" },
    "artifact_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "iteration": { "type": "integer", "minimum": 0 },
    "producer": { "const": "semantic_analyzer" },
    "mode": { "enum": ["diagnosis", "development"] },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["completed", "partial", "failed"] },
    "input_refs": { "type": "array", "items": { "$ref": "#/$defs/ArtifactRef" } },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/ErrorItem" } },
    "runtime_metrics": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/RuntimeMetrics" }]
    },
    "data": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/SemanticData" }]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } } },
      "then": { "properties": { "errors": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": { "properties": { "data": { "type": "null" } } }
    }
  ],
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "iteration", "path", "sha256"],
      "properties": {
        "artifact_id": { "type": "string" },
        "artifact_type": { "type": "string" },
        "iteration": { "type": "integer" },
        "path": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "kind", "path", "sha256", "redacted"],
      "properties": {
        "evidence_id": { "type": "string" },
        "kind": { "enum": ["request", "response", "dom", "screenshot", "state", "execution_log"] },
        "path": { "type": "string" },
        "sha256": { "type": "string" },
        "redacted": { "type": "boolean" }
      }
    },
    "ErrorItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "item_ref", "retryable"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "item_ref": { "type": ["string", "null"] },
        "retryable": { "type": "boolean" }
      }
    },
    "RuntimeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "llm_calls", "input_tokens", "output_tokens", "peak_memory_mb"],
      "properties": {
        "duration_ms": { "type": ["integer", "null"] },
        "llm_calls": { "type": ["integer", "null"] },
        "input_tokens": { "type": ["integer", "null"] },
        "output_tokens": { "type": ["integer", "null"] },
        "peak_memory_mb": { "type": ["number", "null"] }
      }
    },
    "ModelInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_version", "prompt_version", "temperature", "seed"],
      "properties": {
        "model_id": { "type": "string" },
        "model_version": { "type": "string" },
        "prompt_version": { "type": "string" },
        "temperature": { "type": ["number", "null"] },
        "seed": { "type": ["integer", "null"] }
      }
    },
    "SemanticData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalized_requests", "nodes", "relationships", "workflows", "model_info"],
      "properties": {
        "normalized_requests": { "type": "array", "items": { "$ref": "#/$defs/NormalizedRequest" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/GraphNode" } },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/GraphEdge" } },
        "workflows": { "type": "array", "items": { "$ref": "#/$defs/Workflow" } },
        "model_info": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/ModelInfo" }] }
      }
    },
    "ParameterDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_id", "name", "location", "value_type", "is_sensitive"],
      "properties": {
        "parameter_id": { "type": "string" },
        "name": { "type": "string" },
        "location": { "enum": ["path", "query", "body", "header", "cookie"] },
        "value_type": { "enum": ["string", "number", "boolean", "object", "array", "null", "unknown"] },
        "is_sensitive": { "type": "boolean" }
      }
    },
    "NormalizedRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id", "endpoint_id", "method", "path_template", "account_id",
        "role_id", "action_meaning", "resource_ids", "parameters", "basis", "evidence_refs"
      ],
      "properties": {
        "request_id": { "type": "string" },
        "endpoint_id": { "type": "string" },
        "method": { "type": "string" },
        "path_template": { "type": "string" },
        "account_id": { "type": "string" },
        "role_id": { "type": "string" },
        "action_meaning": { "type": "string" },
        "resource_ids": { "type": "array", "items": { "type": "string" } },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/ParameterDefinition" } },
        "basis": { "enum": ["observed", "inferred", "verified"] },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/EvidenceRef" } }
      }
    },
    "GraphNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_type", "properties", "basis", "evidence_refs"],
      "properties": {
        "node_id": { "type": "string" },
        "node_type": { "enum": ["User", "Role", "Page", "Action", "Endpoint", "Parameter", "Resource"] },
        "properties": { "type": "object" },
        "basis": { "enum": ["observed", "inferred", "verified"] },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/EvidenceRef" } }
      },
      "allOf": [
        {
          "if": { "properties": { "node_type": { "const": "Resource" } } },
          "then": { "properties": { "properties": { "$ref": "#/$defs/ResourceProperties" } } }
        }
      ]
    },
    "ResourceIdentifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "ResourceMatchKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_key", "identifiers"],
      "properties": {
        "resource_key": { "type": "string", "minLength": 1 },
        "identifiers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ResourceIdentifier" } }
      }
    },
    "ResourceProperties": {
      "type": "object",
      "required": ["resource_key", "resource_scope", "match_key"],
      "additionalProperties": true,
      "properties": {
        "resource_key": { "type": "string", "minLength": 1 },
        "resource_scope": { "enum": ["type", "instance"] },
        "match_key": { "oneOf": [{ "$ref": "#/$defs/ResourceMatchKey" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "resource_scope": { "const": "type" } } },
          "then": { "properties": { "match_key": { "type": "null" } } }
        },
        {
          "if": { "properties": { "resource_scope": { "const": "instance" } } },
          "then": { "properties": { "match_key": { "$ref": "#/$defs/ResourceMatchKey" } } }
        }
      ]
    },
    "GraphEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship_id", "source_id", "target_id", "relation_type", "properties", "basis", "evidence_refs"],
      "properties": {
        "relationship_id": { "type": "string" },
        "source_id": { "type": "string" },
        "target_id": { "type": "string" },
        "relation_type": {
          "enum": ["HAS_ROLE", "ACCESS", "CALL", "USE", "REFERENCE", "OWNS", "PRECEDES", "REQUIRES", "VERIFIED_ACCESS", "VERIFIED_DENIAL"]
        },
        "properties": { "type": "object" },
        "basis": { "enum": ["observed", "inferred", "verified"] },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/EvidenceRef" } }
      }
    },
    "WorkflowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "order", "action", "request_ids"],
      "properties": {
        "step_id": { "type": "string" },
        "order": { "type": "integer", "minimum": 0 },
        "action": { "type": "string" },
        "request_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "WorkflowDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_step_id", "after_step_id", "condition", "basis", "evidence_refs"],
      "properties": {
        "before_step_id": { "type": "string" },
        "after_step_id": { "type": "string" },
        "condition": { "type": "string" },
        "basis": { "enum": ["observed", "inferred", "verified"] },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/EvidenceRef" } }
      }
    },
    "Workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_id", "name", "role_ids", "steps", "dependencies", "basis", "evidence_refs"],
      "properties": {
        "workflow_id": { "type": "string" },
        "name": { "type": "string" },
        "role_ids": { "type": "array", "items": { "type": "string" } },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/WorkflowStep" } },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/WorkflowDependency" } },
        "basis": { "enum": ["observed", "inferred", "verified"] },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/EvidenceRef" } }
      }
    }
  }
}

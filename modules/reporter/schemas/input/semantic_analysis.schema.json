{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic_analysis.schema.json",
  "title": "semantic_analysis.json input contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "artifact_id", "run_id", "iteration", "producer", "mode", "created_at", "status", "input_refs", "errors", "runtime_metrics", "data"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "artifact_type": {"const": "semantic_analysis"},
    "artifact_id": {"$ref": "#/$defs/nonEmptyString"},
    "run_id": {"$ref": "#/$defs/nonEmptyString"},
    "iteration": {"type": "integer", "minimum": 0},
    "producer": {"const": "semantic_analyzer"},
    "mode": {"enum": ["diagnosis", "development"]},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["completed", "partial", "failed"]},
    "input_refs": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/errorItem"}},
    "runtime_metrics": {"oneOf": [{"$ref": "#/$defs/runtimeMetrics"}, {"type": "null"}]},
    "data": {"oneOf": [{"$ref": "#/$defs/semanticData"}, {"type": "null"}]}
  },
  "allOf": [{"$ref": "#/$defs/statusRules"}],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "jsonValue": {},
    "artifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "iteration", "path", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/nonEmptyString"}, "artifact_type": {"$ref": "#/$defs/nonEmptyString"},
        "iteration": {"type": "integer", "minimum": 0}, "path": {"$ref": "#/$defs/nonEmptyString"}, "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidenceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "kind", "path", "sha256", "redacted"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/nonEmptyString"}, "kind": {"enum": ["request", "response", "dom", "screenshot", "state", "execution_log"]},
        "path": {"$ref": "#/$defs/nonEmptyString"}, "sha256": {"$ref": "#/$defs/sha256"}, "redacted": {"type": "boolean"}
      }
    },
    "errorItem": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "item_ref", "retryable"],
      "properties": {"code": {"$ref": "#/$defs/nonEmptyString"}, "message": {"$ref": "#/$defs/nonEmptyString"}, "item_ref": {"type": ["string", "null"]}, "retryable": {"type": "boolean"}}
    },
    "runtimeMetrics": {
      "type": "object", "additionalProperties": false,
      "required": ["duration_ms", "llm_calls", "input_tokens", "output_tokens", "peak_memory_mb"],
      "properties": {
        "duration_ms": {"type": ["integer", "null"], "minimum": 0}, "llm_calls": {"type": ["integer", "null"], "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0}, "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "peak_memory_mb": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "modelInfo": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "model_version", "prompt_version", "temperature", "seed"],
      "properties": {
        "model_id": {"$ref": "#/$defs/nonEmptyString"}, "model_version": {"$ref": "#/$defs/nonEmptyString"}, "prompt_version": {"$ref": "#/$defs/nonEmptyString"},
        "temperature": {"type": ["number", "null"]}, "seed": {"type": ["integer", "null"]}
      }
    },
    "parameterDefinition": {
      "type": "object", "additionalProperties": false,
      "required": ["parameter_id", "name", "location", "value_type", "is_sensitive"],
      "properties": {
        "parameter_id": {"$ref": "#/$defs/nonEmptyString"}, "name": {"$ref": "#/$defs/nonEmptyString"},
        "location": {"enum": ["path", "query", "body", "header", "cookie"]}, "value_type": {"enum": ["string", "number", "boolean", "object", "array", "null", "unknown"]},
        "is_sensitive": {"type": "boolean"}
      }
    },
    "normalizedRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "endpoint_id", "method", "path_template", "account_id", "role_id", "action_meaning", "resource_ids", "parameters", "basis", "evidence_refs"],
      "properties": {
        "request_id": {"$ref": "#/$defs/nonEmptyString"}, "endpoint_id": {"$ref": "#/$defs/nonEmptyString"}, "method": {"type": "string", "pattern": "^[A-Z]+$"},
        "path_template": {"$ref": "#/$defs/nonEmptyString"}, "account_id": {"$ref": "#/$defs/nonEmptyString"}, "role_id": {"$ref": "#/$defs/nonEmptyString"},
        "action_meaning": {"$ref": "#/$defs/nonEmptyString"}, "resource_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameterDefinition"}}, "basis": {"enum": ["observed", "inferred", "verified"]},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    },
    "graphNode": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "node_type", "properties", "basis", "evidence_refs"],
      "properties": {
        "node_id": {"$ref": "#/$defs/nonEmptyString"}, "node_type": {"enum": ["User", "Role", "Page", "Action", "Endpoint", "Parameter", "Resource"]},
        "properties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}, "basis": {"enum": ["observed", "inferred", "verified"]},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    },
    "graphEdge": {
      "type": "object", "additionalProperties": false,
      "required": ["relationship_id", "source_id", "target_id", "relation_type", "properties", "basis", "evidence_refs"],
      "properties": {
        "relationship_id": {"$ref": "#/$defs/nonEmptyString"}, "source_id": {"$ref": "#/$defs/nonEmptyString"}, "target_id": {"$ref": "#/$defs/nonEmptyString"},
        "relation_type": {"enum": ["HAS_ROLE", "ACCESS", "CALL", "USE", "REFERENCE", "OWNS", "PRECEDES", "REQUIRES", "VERIFIED_ACCESS", "VERIFIED_DENIAL"]},
        "properties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}, "basis": {"enum": ["observed", "inferred", "verified"]},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    },
    "workflowStep": {
      "type": "object", "additionalProperties": false,
      "required": ["step_id", "order", "action", "request_ids"],
      "properties": {"step_id": {"$ref": "#/$defs/nonEmptyString"}, "order": {"type": "integer", "minimum": 0}, "action": {"$ref": "#/$defs/nonEmptyString"}, "request_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}}}
    },
    "workflowDependency": {
      "type": "object", "additionalProperties": false,
      "required": ["before_step_id", "after_step_id", "condition", "basis", "evidence_refs"],
      "properties": {
        "before_step_id": {"$ref": "#/$defs/nonEmptyString"}, "after_step_id": {"$ref": "#/$defs/nonEmptyString"}, "condition": {"type": "string"},
        "basis": {"enum": ["observed", "inferred", "verified"]}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    },
    "workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow_id", "name", "role_ids", "steps", "dependencies", "basis", "evidence_refs"],
      "properties": {
        "workflow_id": {"$ref": "#/$defs/nonEmptyString"}, "name": {"$ref": "#/$defs/nonEmptyString"}, "role_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/workflowStep"}}, "dependencies": {"type": "array", "items": {"$ref": "#/$defs/workflowDependency"}},
        "basis": {"enum": ["observed", "inferred", "verified"]}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    },
    "semanticData": {
      "type": "object", "additionalProperties": false,
      "required": ["normalized_requests", "nodes", "relationships", "workflows", "model_info"],
      "properties": {
        "normalized_requests": {"type": "array", "items": {"$ref": "#/$defs/normalizedRequest"}},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/graphNode"}}, "relationships": {"type": "array", "items": {"$ref": "#/$defs/graphEdge"}},
        "workflows": {"type": "array", "items": {"$ref": "#/$defs/workflow"}}, "model_info": {"oneOf": [{"$ref": "#/$defs/modelInfo"}, {"type": "null"}]}
      }
    },
    "statusRules": {
      "allOf": [
        {"if": {"properties": {"status": {"const": "completed"}}}, "then": {"properties": {"errors": {"maxItems": 0}, "data": {"$ref": "#/$defs/semanticData"}}}},
        {"if": {"properties": {"status": {"const": "partial"}}}, "then": {"properties": {"errors": {"minItems": 1}, "data": {"$ref": "#/$defs/semanticData"}}}},
        {"if": {"properties": {"status": {"const": "failed"}}}, "then": {"properties": {"errors": {"minItems": 1}, "data": {"type": "null"}}}}
      ]
    }
  }
}

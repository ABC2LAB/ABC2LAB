{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graph_query_result.schema.json",
  "title": "graph_query_result.json input contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "artifact_id", "run_id", "iteration", "producer", "mode", "created_at", "status", "input_refs", "errors", "runtime_metrics", "data"],
  "properties": {
    "schema_version": {"const": "0.1.0"}, "artifact_type": {"const": "graph_query_result"}, "artifact_id": {"$ref": "#/$defs/nonEmptyString"},
    "run_id": {"$ref": "#/$defs/nonEmptyString"}, "iteration": {"type": "integer", "minimum": 0}, "producer": {"const": "knowledge_graph"},
    "mode": {"enum": ["diagnosis", "development"]}, "created_at": {"type": "string", "format": "date-time"}, "status": {"enum": ["completed", "partial", "failed"]},
    "input_refs": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}}, "errors": {"type": "array", "items": {"$ref": "#/$defs/errorItem"}},
    "runtime_metrics": {"oneOf": [{"$ref": "#/$defs/runtimeMetrics"}, {"type": "null"}]}, "data": {"oneOf": [{"$ref": "#/$defs/resultData"}, {"type": "null"}]}
  },
  "allOf": [{"$ref": "#/$defs/statusRules"}],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "jsonValue": {},
    "artifactRef": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "artifact_type", "iteration", "path", "sha256"], "properties": {"artifact_id": {"$ref": "#/$defs/nonEmptyString"}, "artifact_type": {"$ref": "#/$defs/nonEmptyString"}, "iteration": {"type": "integer", "minimum": 0}, "path": {"$ref": "#/$defs/nonEmptyString"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "evidenceRef": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "kind", "path", "sha256", "redacted"], "properties": {"evidence_id": {"$ref": "#/$defs/nonEmptyString"}, "kind": {"enum": ["request", "response", "dom", "screenshot", "state", "execution_log"]}, "path": {"$ref": "#/$defs/nonEmptyString"}, "sha256": {"$ref": "#/$defs/sha256"}, "redacted": {"type": "boolean"}}},
    "errorItem": {"type": "object", "additionalProperties": false, "required": ["code", "message", "item_ref", "retryable"], "properties": {"code": {"$ref": "#/$defs/nonEmptyString"}, "message": {"$ref": "#/$defs/nonEmptyString"}, "item_ref": {"type": ["string", "null"]}, "retryable": {"type": "boolean"}}},
    "runtimeMetrics": {"type": "object", "additionalProperties": false, "required": ["duration_ms", "llm_calls", "input_tokens", "output_tokens", "peak_memory_mb"], "properties": {"duration_ms": {"type": ["integer", "null"], "minimum": 0}, "llm_calls": {"type": ["integer", "null"], "minimum": 0}, "input_tokens": {"type": ["integer", "null"], "minimum": 0}, "output_tokens": {"type": ["integer", "null"], "minimum": 0}, "peak_memory_mb": {"type": ["number", "null"], "minimum": 0}}},
    "graphNode": {"type": "object", "additionalProperties": false, "required": ["node_id", "node_type", "properties", "basis", "evidence_refs"], "properties": {"node_id": {"$ref": "#/$defs/nonEmptyString"}, "node_type": {"enum": ["User", "Role", "Page", "Action", "Endpoint", "Parameter", "Resource"]}, "properties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}, "basis": {"enum": ["observed", "inferred", "verified"]}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}}}},
    "graphEdge": {"type": "object", "additionalProperties": false, "required": ["relationship_id", "source_id", "target_id", "relation_type", "properties", "basis", "evidence_refs"], "properties": {"relationship_id": {"$ref": "#/$defs/nonEmptyString"}, "source_id": {"$ref": "#/$defs/nonEmptyString"}, "target_id": {"$ref": "#/$defs/nonEmptyString"}, "relation_type": {"enum": ["HAS_ROLE", "ACCESS", "CALL", "USE", "REFERENCE", "OWNS", "PRECEDES", "REQUIRES", "VERIFIED_ACCESS", "VERIFIED_DENIAL"]}, "properties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}, "basis": {"enum": ["observed", "inferred", "verified"]}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}}}},
    "workflowStep": {"type": "object", "additionalProperties": false, "required": ["step_id", "order", "action", "request_ids"], "properties": {"step_id": {"$ref": "#/$defs/nonEmptyString"}, "order": {"type": "integer", "minimum": 0}, "action": {"$ref": "#/$defs/nonEmptyString"}, "request_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}}}},
    "workflowDependency": {"type": "object", "additionalProperties": false, "required": ["before_step_id", "after_step_id", "condition", "basis", "evidence_refs"], "properties": {"before_step_id": {"$ref": "#/$defs/nonEmptyString"}, "after_step_id": {"$ref": "#/$defs/nonEmptyString"}, "condition": {"type": "string"}, "basis": {"enum": ["observed", "inferred", "verified"]}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}}}},
    "workflow": {"type": "object", "additionalProperties": false, "required": ["workflow_id", "name", "role_ids", "steps", "dependencies", "basis", "evidence_refs"], "properties": {"workflow_id": {"$ref": "#/$defs/nonEmptyString"}, "name": {"$ref": "#/$defs/nonEmptyString"}, "role_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}}, "steps": {"type": "array", "items": {"$ref": "#/$defs/workflowStep"}}, "dependencies": {"type": "array", "items": {"$ref": "#/$defs/workflowDependency"}}, "basis": {"enum": ["observed", "inferred", "verified"]}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}}}},
    "ownershipRow": {"type": "object", "additionalProperties": false, "required": ["resource_id", "owner_account_id", "basis", "evidence_refs"], "properties": {"resource_id": {"$ref": "#/$defs/nonEmptyString"}, "owner_account_id": {"$ref": "#/$defs/nonEmptyString"}, "basis": {"enum": ["observed", "inferred", "verified"]}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}}}},
    "accessRow": {"type": "object", "additionalProperties": false, "required": ["account_id", "role_id", "endpoint_id", "resource_id", "action", "access_observed", "evidence_refs"], "properties": {"account_id": {"$ref": "#/$defs/nonEmptyString"}, "role_id": {"$ref": "#/$defs/nonEmptyString"}, "endpoint_id": {"$ref": "#/$defs/nonEmptyString"}, "resource_id": {"type": ["string", "null"]}, "action": {"$ref": "#/$defs/nonEmptyString"}, "access_observed": {"type": "boolean"}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}}}},
    "flowRow": {"type": "object", "additionalProperties": false, "required": ["workflow_id", "before_step_id", "after_step_id", "condition", "basis", "evidence_refs"], "properties": {"workflow_id": {"$ref": "#/$defs/nonEmptyString"}, "before_step_id": {"$ref": "#/$defs/nonEmptyString"}, "after_step_id": {"$ref": "#/$defs/nonEmptyString"}, "condition": {"type": "string"}, "basis": {"enum": ["observed", "inferred", "verified"]}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}}}},
    "graphSnapshot": {"type": "object", "additionalProperties": false, "required": ["nodes", "relationships", "workflows"], "properties": {"nodes": {"type": "array", "items": {"$ref": "#/$defs/graphNode"}}, "relationships": {"type": "array", "items": {"$ref": "#/$defs/graphEdge"}}, "workflows": {"type": "array", "items": {"$ref": "#/$defs/workflow"}}}},
    "ownershipResult": {"$ref": "#/$defs/resultBaseOwnership"},
    "resultBaseOwnership": {"type": "object", "additionalProperties": false, "required": ["query_id", "query_key", "status", "rows", "errors"], "properties": {"query_id": {"$ref": "#/$defs/nonEmptyString"}, "query_key": {"const": "resource_ownership"}, "status": {"enum": ["completed", "failed"]}, "rows": {"type": "array", "items": {"$ref": "#/$defs/ownershipRow"}}, "errors": {"type": "array", "items": {"$ref": "#/$defs/errorItem"}}}},
    "accessResult": {"type": "object", "additionalProperties": false, "required": ["query_id", "query_key", "status", "rows", "errors"], "properties": {"query_id": {"$ref": "#/$defs/nonEmptyString"}, "query_key": {"const": "role_resource_access"}, "status": {"enum": ["completed", "failed"]}, "rows": {"type": "array", "items": {"$ref": "#/$defs/accessRow"}}, "errors": {"type": "array", "items": {"$ref": "#/$defs/errorItem"}}}},
    "flowResult": {"type": "object", "additionalProperties": false, "required": ["query_id", "query_key", "status", "rows", "errors"], "properties": {"query_id": {"$ref": "#/$defs/nonEmptyString"}, "query_key": {"const": "workflow_dependencies"}, "status": {"enum": ["completed", "failed"]}, "rows": {"type": "array", "items": {"$ref": "#/$defs/flowRow"}}, "errors": {"type": "array", "items": {"$ref": "#/$defs/errorItem"}}}},
    "snapshotResult": {"type": "object", "additionalProperties": false, "required": ["query_id", "query_key", "status", "rows", "errors"], "properties": {"query_id": {"$ref": "#/$defs/nonEmptyString"}, "query_key": {"const": "structure_snapshot"}, "status": {"enum": ["completed", "failed"]}, "rows": {"type": "array", "items": {"$ref": "#/$defs/graphSnapshot"}}, "errors": {"type": "array", "items": {"$ref": "#/$defs/errorItem"}}}},
    "resultData": {"type": "object", "additionalProperties": false, "required": ["graph_id", "graph_revision", "results"], "properties": {"graph_id": {"$ref": "#/$defs/nonEmptyString"}, "graph_revision": {"type": "integer", "minimum": 0}, "results": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/ownershipResult"}, {"$ref": "#/$defs/accessResult"}, {"$ref": "#/$defs/flowResult"}, {"$ref": "#/$defs/snapshotResult"}]}}}},
    "statusRules": {"allOf": [
      {"if": {"properties": {"status": {"const": "completed"}}}, "then": {"properties": {"errors": {"maxItems": 0}, "data": {"$ref": "#/$defs/resultData"}}}},
      {"if": {"properties": {"status": {"const": "partial"}}}, "then": {"properties": {"errors": {"minItems": 1}, "data": {"$ref": "#/$defs/resultData"}}}},
      {"if": {"properties": {"status": {"const": "failed"}}}, "then": {"properties": {"errors": {"minItems": 1}, "data": {"type": "null"}}}}
    ]}
  }
}

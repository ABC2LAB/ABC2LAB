{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verification_results.schema.json",
  "title": "verification_results.json input contract",
  "description": "생산자: verifier(verify). 직접 소비자: knowledge_graph, reporter. 기준: docs/spec/m7-verifier.md, 02-common-contract.md. 미실행·판단불가를 '취약점 없음'으로 기록하지 않는다. graph_updates는 basis=verified와 실제 실행 근거가 있는 관찰만 담는다. 계약이 바뀌면 소비자와 합의 후 같이 고친다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "artifact_id", "run_id", "iteration", "producer",
    "mode", "created_at", "status", "input_refs", "errors", "runtime_metrics", "data"
  ],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "artifact_type": { "const": "verification_results" },
    "artifact_id": { "$ref": "#/$defs/nonEmptyString" },
    "run_id": { "$ref": "#/$defs/nonEmptyString" },
    "iteration": { "type": "integer", "minimum": 0 },
    "producer": { "const": "verifier" },
    "mode": { "enum": ["diagnosis", "development"] },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["completed", "partial", "failed"] },
    "input_refs": { "type": "array", "items": { "$ref": "#/$defs/artifactRef" } },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/errorItem" } },
    "runtime_metrics": { "oneOf": [{ "$ref": "#/$defs/runtimeMetrics" }, { "type": "null" }] },
    "data": { "oneOf": [{ "$ref": "#/$defs/verificationData" }, { "type": "null" }] }
  },
  "allOf": [{ "$ref": "#/$defs/statusRules" }],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "jsonValue": { "type": ["string", "number", "boolean", "object", "array", "null"] },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "iteration", "path", "sha256"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/nonEmptyString" },
        "artifact_type": { "$ref": "#/$defs/nonEmptyString" },
        "iteration": { "type": "integer", "minimum": 0 },
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "kind", "path", "sha256", "redacted"],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["request", "response", "dom", "screenshot", "state", "execution_log"] },
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "redacted": { "type": "boolean" }
      }
    },
    "errorItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "item_ref", "retryable"],
      "properties": {
        "code": { "$ref": "#/$defs/nonEmptyString" },
        "message": { "$ref": "#/$defs/nonEmptyString" },
        "item_ref": { "type": ["string", "null"] },
        "retryable": { "type": "boolean" }
      }
    },
    "runtimeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "llm_calls", "input_tokens", "output_tokens", "peak_memory_mb"],
      "properties": {
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "llm_calls": { "type": ["integer", "null"], "minimum": 0 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "peak_memory_mb": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "passed", "observed", "description"],
      "properties": {
        "check_id": { "$ref": "#/$defs/nonEmptyString" },
        "passed": { "type": ["boolean", "null"] },
        "observed": { "$ref": "#/$defs/jsonValue" },
        "description": { "type": "string" }
      }
    },
    "executedStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "status", "request_url", "response_status", "request_ref", "response_ref", "check_results", "evidence_refs", "errors"],
      "properties": {
        "step_id": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "enum": ["completed", "error", "skipped"] },
        "request_url": { "type": ["string", "null"] },
        "response_status": { "type": ["integer", "null"] },
        "request_ref": { "oneOf": [{ "$ref": "#/$defs/evidenceRef" }, { "type": "null" }] },
        "response_ref": { "oneOf": [{ "$ref": "#/$defs/evidenceRef" }, { "type": "null" }] },
        "check_results": { "type": "array", "items": { "$ref": "#/$defs/checkResult" } },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/errorItem" } }
      }
    },
    "verificationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_id", "candidate_id", "scenario_id", "decision_id", "policy_decision", "execution_status", "result", "reason", "steps", "evidence_refs", "errors"],
      "properties": {
        "verification_id": { "$ref": "#/$defs/nonEmptyString" },
        "candidate_id": { "$ref": "#/$defs/nonEmptyString" },
        "scenario_id": { "$ref": "#/$defs/nonEmptyString" },
        "decision_id": { "$ref": "#/$defs/nonEmptyString" },
        "policy_decision": { "enum": ["allow", "block", "require_approval"] },
        "execution_status": { "enum": ["completed", "not_executed", "error"] },
        "result": { "enum": ["success", "failure", "blocked", "indeterminate"] },
        "reason": { "type": "string" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/executedStep" } },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/errorItem" } }
      }
    },
    "graphUpdateNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_type", "properties", "basis", "evidence_refs"],
      "properties": {
        "node_id": { "$ref": "#/$defs/nonEmptyString" },
        "node_type": { "enum": ["User", "Role", "Page", "Action", "Endpoint", "Parameter"] },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } },
        "basis": { "const": "verified" },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "graphUpdateEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship_id", "source_id", "target_id", "relation_type", "properties", "basis", "evidence_refs"],
      "properties": {
        "relationship_id": { "$ref": "#/$defs/nonEmptyString" },
        "source_id": { "$ref": "#/$defs/nonEmptyString" },
        "target_id": { "$ref": "#/$defs/nonEmptyString" },
        "relation_type": { "enum": ["VERIFIED_ACCESS", "VERIFIED_DENIAL"] },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } },
        "basis": { "const": "verified" },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "graphUpdates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_verification_ids", "nodes", "relationships"],
      "properties": {
        "source_verification_ids": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/graphUpdateNode" } },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/graphUpdateEdge" } }
      }
    },
    "verificationData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_graph_revision", "scenarios_sha256", "results", "graph_updates"],
      "properties": {
        "source_graph_revision": { "type": "integer", "minimum": 0 },
        "scenarios_sha256": { "$ref": "#/$defs/sha256" },
        "results": { "type": "array", "items": { "$ref": "#/$defs/verificationItem" } },
        "graph_updates": { "$ref": "#/$defs/graphUpdates" }
      }
    },
    "statusRules": {
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "completed" } } },
          "then": { "properties": { "errors": { "maxItems": 0 }, "data": { "$ref": "#/$defs/verificationData" } } }
        },
        {
          "if": { "properties": { "status": { "const": "partial" } } },
          "then": { "properties": { "errors": { "minItems": 1 }, "data": { "$ref": "#/$defs/verificationData" } } }
        },
        {
          "if": { "properties": { "status": { "const": "failed" } } },
          "then": { "properties": { "errors": { "minItems": 1 }, "data": { "type": "null" } } }
        }
      ]
    }
  }
}

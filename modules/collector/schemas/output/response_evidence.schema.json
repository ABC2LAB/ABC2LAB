{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:abc2lab:collector:response_evidence:0.1.0",
  "title": "collector 응답 근거 파일 (EvidenceRef kind=response)",
  "description": "JSON 응답 하나의 키 구조+타입(shape)과 식별자 목록. 본문 값은 식별자 규칙에 맞는 것만 남긴다. 위치: evidence/collector/response/request-<N>.json. 한계: 문자열 id(slug·username), id 꼴이 아닌 키 이름, 객체 키 자리에 오는 id({\"17\": {...}})는 식별자로 잡지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "evidence_id", "request_id", "shape", "identifiers", "identifiers_truncated"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "kind": { "const": "response" },
    "evidence_id": { "type": "string" },
    "request_id": { "type": "string" },
    "shape": { "$ref": "#/$defs/ShapeNode" },
    "identifiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/Identifier" }
    },
    "identifiers_truncated": {
      "description": "개수 상한을 넘어 식별자를 일부만 남겼으면 true",
      "type": "boolean"
    }
  },
  "$defs": {
    "ShapeNode": {
      "description": "잎은 타입 이름(int, str|null 등)이고 값은 담지 않는다. 배열은 원소 모양을 합친 하나만 남긴다. 객체 키는 JSON map이라 확장 가능하다.",
      "anyOf": [
        { "$ref": "#/$defs/ShapeLeaf" },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/ShapeNode" } },
        { "type": "array", "maxItems": 1, "items": { "$ref": "#/$defs/ShapeNode" } }
      ]
    },
    "ShapeLeaf": {
      "description": "타입 이름을 |로 이은 값, 또는 키 수 상한을 넘겨 잘린 객체 표시(truncated)",
      "type": "string",
      "pattern": "^((bool|int|float|str|null|dict|list)(\\|(bool|int|float|str|null|dict|list))*|truncated)$"
    },
    "Identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer", "value"],
      "properties": {
        "pointer": {
          "description": "응답 본문 안 위치. RFC 6901 JSON Pointer(~는 ~0, /는 ~1)",
          "type": "string",
          "pattern": "^(/([^~/]|~[01])*)+$"
        },
        "value": {
          "description": "0 이상의 정수, 숫자로만 된 문자열, 또는 UUID 문자열. 응답의 원래 JSON 타입을 그대로 둔다(\"42\"는 문자열로)",
          "anyOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string", "pattern": "^[0-9]+$" },
            {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          ]
        }
      }
    }
  }
}

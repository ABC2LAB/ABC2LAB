{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abc2lab/semantic_analyzer/input/crawl_result.schema.json",
  "title": "crawl_result (collector 출력 계약의 semantic_analyzer 입력 사본)",
  "description": "m1-collector.md v0.1 기준. collector가 생산하고 semantic_analyzer가 읽는 계약의 소비자 측 사본이다. 계약 변경은 생산자(collector)와 합의한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "artifact_id", "run_id", "iteration",
    "producer", "mode", "created_at", "status", "input_refs", "errors",
    "runtime_metrics", "data"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "artifact_type": { "const": "crawl_result" },
    "artifact_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "iteration": { "type": "integer", "minimum": 0 },
    "producer": { "const": "collector" },
    "mode": { "enum": ["diagnosis", "development"] },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["completed", "partial", "failed"] },
    "input_refs": { "type": "array", "items": { "$ref": "#/$defs/ArtifactRef" } },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/ErrorItem" } },
    "runtime_metrics": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/RuntimeMetrics" }]
    },
    "data": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/CrawlData" }]
    }
  },
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "iteration", "path", "sha256"],
      "properties": {
        "artifact_id": { "type": "string" },
        "artifact_type": { "type": "string" },
        "iteration": { "type": "integer" },
        "path": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "kind", "path", "sha256", "redacted"],
      "properties": {
        "evidence_id": { "type": "string" },
        "kind": { "enum": ["request", "response", "dom", "screenshot", "state", "execution_log"] },
        "path": { "type": "string" },
        "sha256": { "type": "string" },
        "redacted": { "type": "boolean" }
      }
    },
    "ErrorItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "item_ref", "retryable"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "item_ref": { "type": ["string", "null"] },
        "retryable": { "type": "boolean" }
      }
    },
    "RuntimeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "llm_calls", "input_tokens", "output_tokens", "peak_memory_mb"],
      "properties": {
        "duration_ms": { "type": ["integer", "null"] },
        "llm_calls": { "type": ["integer", "null"] },
        "input_tokens": { "type": ["integer", "null"] },
        "output_tokens": { "type": ["integer", "null"] },
        "peak_memory_mb": { "type": ["number", "null"] }
      }
    },
    "CrawlData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_url", "roles", "accounts", "pages", "actions", "requests"],
      "properties": {
        "target_url": { "type": "string" },
        "roles": { "type": "array", "items": { "$ref": "#/$defs/Role" } },
        "accounts": { "type": "array", "items": { "$ref": "#/$defs/Account" } },
        "pages": { "type": "array", "items": { "$ref": "#/$defs/Page" } },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/Action" } },
        "requests": { "type": "array", "items": { "$ref": "#/$defs/ObservedRequest" } }
      }
    },
    "Role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "name"],
      "properties": {
        "role_id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "Account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "role_id", "alias", "session_ref"],
      "properties": {
        "account_id": { "type": "string" },
        "role_id": { "type": "string" },
        "alias": { "type": "string" },
        "session_ref": { "type": ["string", "null"] }
      }
    },
    "Page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_id", "url", "title", "evidence_refs"],
      "properties": {
        "page_id": { "type": "string" },
        "url": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/EvidenceRef" } }
      }
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "page_id", "kind", "label", "evidence_refs"],
      "properties": {
        "action_id": { "type": "string" },
        "page_id": { "type": "string" },
        "kind": { "enum": ["navigate", "click", "submit", "input", "other"] },
        "label": { "type": ["string", "null"] },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/EvidenceRef" } }
      }
    },
    "ObservedParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "location", "value", "is_sensitive"],
      "properties": {
        "name": { "type": "string" },
        "location": { "enum": ["path", "query", "body", "header", "cookie"] },
        "value": {},
        "is_sensitive": { "type": "boolean" }
      }
    },
    "HeaderMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "redacted"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": ["string", "null"] },
        "redacted": { "type": "boolean" }
      }
    },
    "ResponseMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status_code", "content_type", "headers", "body_ref"],
      "properties": {
        "status_code": { "type": ["integer", "null"] },
        "content_type": { "type": ["string", "null"] },
        "headers": { "type": "array", "items": { "$ref": "#/$defs/HeaderMeta" } },
        "body_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/EvidenceRef" }] }
      }
    },
    "ObservedRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id", "account_id", "role_id", "session_ref", "page_id",
        "action_id", "method", "url", "observed_at", "parameters", "headers",
        "body_ref", "response", "evidence_refs"
      ],
      "properties": {
        "request_id": { "type": "string" },
        "account_id": { "type": "string" },
        "role_id": { "type": "string" },
        "session_ref": { "type": ["string", "null"] },
        "page_id": { "type": ["string", "null"] },
        "action_id": { "type": ["string", "null"] },
        "method": { "type": "string" },
        "url": { "type": "string" },
        "observed_at": { "type": "string", "format": "date-time" },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/ObservedParameter" } },
        "headers": { "type": "array", "items": { "$ref": "#/$defs/HeaderMeta" } },
        "body_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/EvidenceRef" }] },
        "response": { "$ref": "#/$defs/ResponseMeta" },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/EvidenceRef" } }
      }
    }
  }
}

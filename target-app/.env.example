# Docker Compose - Secure 모드 설정
SECURE_HOST=0.0.0.0
SECURE_PORT=8000

# Docker Compose - Vulnerable 모드 설정
VULN_HOST=0.0.0.0
VULN_PORT=8001

# FastAPI 설정 (로컬 개발용 uvicorn 실행 시)
HOST=127.0.0.1
PORT=8000

# 데이터베이스
DATABASE_URL=sqlite:///./testapp.db

# 보안 키 (프로덕션에서는 반드시 변경)
SECRET_KEY=dev-secret-key-change-in-production

# 취약점 모드 (secure 또는 vulnerable)
VULN_MODE=secure

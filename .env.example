# 복사해서 .env로 쓰고 값을 바꾼다. .env는 커밋하지 않는다.

# 테스트 앱 호스트 포트 (127.0.0.1에만 열림)
SECURE_PORT=8000
VULN_PORT=8001

# 테스트 앱 세션 서명 키
SECURE_SECRET_KEY=change-me-secure
VULN_SECRET_KEY=change-me-vulnerable

# LLM (analyzer). 키 값은 .env에만 넣고 절대 커밋하지 않는다.
OPENAI_API_KEY=
OPENAI_MODEL=

# Neo4j. 비밀번호는 8자 이상이어야 한다. compose와 드라이버가 같은 값을 쓴다.
NEO4J_PASSWORD=change-me-neo4j
# 드라이버 접속 정보. 사용자 이름은 compose가 neo4j로 고정한다. URI 포트는 NEO4J_BOLT_PORT와 맞춘다.
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# 크롤러. 대상은 로컬(localhost/127.0.0.1/::1) http(s)만 허용된다.
CRAWLER_TARGET_URL=http://localhost:8001
# 대상 외에 허용할 origin(쉼표 구분). 비우면 대상 origin만.
CRAWLER_EXTRA_ALLOWED_ORIGINS=
# 계정 있는 역할(쉼표 구분, 소문자·숫자·_). guest는 자동 포함이라 적지 않는다. 비우면 guest만.
CRAWLER_ROLES=user,admin
# 역할마다 CRAWLER_ROLE_{역할 대문자}_USERNAME / _PASSWORD
CRAWLER_ROLE_USER_USERNAME=change-me
CRAWLER_ROLE_USER_PASSWORD=change-me
CRAWLER_ROLE_ADMIN_USERNAME=change-me
CRAWLER_ROLE_ADMIN_PASSWORD=change-me
# 로그인 폼. 필드 이름은 input의 name 속성. 계정 역할이 있으면 필수.
CRAWLER_LOGIN_PATH=/login
CRAWLER_LOGIN_USERNAME_FIELD=change-me
CRAWLER_LOGIN_PASSWORD_FIELD=change-me
# 성공 판단: left_login_page | url_contains | cookie_present | text_present
# left_login_page 외에는 CRAWLER_LOGIN_SUCCESS_VALUE(비교할 URL 조각·쿠키 이름·문구)가 필수.
CRAWLER_LOGIN_SUCCESS_CHECK=left_login_page
CRAWLER_LOGIN_SUCCESS_VALUE=
# 탐색 깊이(기본 3), 상태 변경 동작 실행 허용(기본 false, true/false만)
CRAWLER_MAX_DEPTH=3
CRAWLER_ALLOW_STATE_CHANGING=false

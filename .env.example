# 복사해서 .env로 쓰고 값을 바꾼다. .env는 커밋하지 않는다.

# 테스트 앱 호스트 포트 (127.0.0.1에만 열림)
SECURE_PORT=8000
VULN_PORT=8001

# 테스트 앱 세션 서명 키
SECURE_SECRET_KEY=change-me-secure
VULN_SECRET_KEY=change-me-vulnerable

# LLM (analyzer). 키 값은 .env에만 넣고 절대 커밋하지 않는다.
OPENAI_API_KEY=
OPENAI_MODEL=

# Neo4j. 비밀번호는 8자 이상이어야 한다. compose와 드라이버가 같은 값을 쓴다.
NEO4J_PASSWORD=change-me-neo4j
# 드라이버 접속 정보. 사용자 이름은 compose가 neo4j로 고정한다. URI 포트는 NEO4J_BOLT_PORT와 맞춘다.
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# collector(웹 정보 수집기): 설정은 modules/collector/configs/collector.example.toml, 계정 로그인 ID·비밀번호(COLLECTOR_ACCOUNT_*)는 modules/collector/.env.example 참고

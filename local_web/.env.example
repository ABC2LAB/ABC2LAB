# 이 예시를 바탕으로 local_web/.env를 직접 준비한다. 실제 파일은 커밋하지 않는다.
# Neo4j가 허용하는 비밀번호를 설정한다(최소 8자). 빈 값으로 실행할 수 없다.
NEO4J_PASSWORD=
LOCAL_WEB_PORT=8080
# 호스트의 Collector TOML 절대 경로. 비밀값 없이 로그인·탐색 설정만 준비한다.
LOCAL_WEB_COLLECTOR_CONFIG_PATH=
# 호스트의 datasets 디렉터리 절대 경로. <dataset_id>/ground_truth.json 형태.
LOCAL_WEB_DATASETS_DIR=
# 테스트 웹이 이미 연결된 Docker 네트워크 이름. ABC2LAB만 추가로 참여한다.
LOCAL_WEB_TARGET_NETWORK=
# 미리 만든 호스트 결과 폴더. UID 10001 쓰기 권한과 제한된 접근 권한이 필요하다.
LOCAL_WEB_RUNS_DIR=
# 운영자가 준비한 비밀값 없는 공개 설정 원본. 모두 읽기 전용 마운트한다.
# 두 LLM 설정은 [llm] provider="ollama", 실제 model_id, base_url="http://ollama:11434"로 준비한다.
LOCAL_WEB_SEMANTIC_CONFIG_PATH=
LOCAL_WEB_SCENARIO_CONFIG_PATH=
LOCAL_WEB_POLICY_CONFIG_PATH=
LOCAL_WEB_MATCHING_PROFILE=default-v1
# 이미지 변경이 필요할 때만 지정한다. 기본값은 compose.yml의 고정 digest다.
# OLLAMA_IMAGE=ollama/ollama@sha256:<검증한 이미지 digest>
